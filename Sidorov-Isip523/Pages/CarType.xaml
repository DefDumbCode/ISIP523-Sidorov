<Page x:Class="Sidorov_Isip523.Pages.CarType"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Sidorov_Isip523.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="CarType">

    <Grid Background="BurlyWood">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width ="*"/>
            <ColumnDefinition Width ="250"/>
            <ColumnDefinition Width ="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height ="*"/>
            <RowDefinition Height ="50"/>
            <RowDefinition Height ="150"/>
            <RowDefinition Height ="150"/>
            <RowDefinition Height ="*"/>
        </Grid.RowDefinitions>
        <TextBlock Text="Выберите машину и тип двигателя" Grid.Column="1" Grid.Row="1" VerticalAlignment="Center" TextAlignment="Center"/>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Grid.Row="2" Grid.Column="1">
            <RadioButton GroupName="CarTypes" Content="Молния МакКуин"/>
            <RadioButton GroupName="CarTypes" Content="Автобус (победил Цоя)"/>
            <RadioButton GroupName="CarTypes" Content="Трансформер"/>
            <RadioButton GroupName="CarTypes" Content="Танк"/>
        </StackPanel>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Grid.Row="3" Grid.Column="1">
            <RadioButton GroupName="EngineTypes" Content="Дизельный"/>
            <RadioButton GroupName="EngineTypes" Content="Электрический"/>
            <RadioButton GroupName="EngineTypes" Content="Гибридный"/>
        </StackPanel>
    </Grid>
</Page>
