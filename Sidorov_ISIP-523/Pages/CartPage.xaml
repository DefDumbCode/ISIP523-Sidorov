<Page x:Class="Sidorov_ISIP_523.Pages.CartPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Sidorov_ISIP_523.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="CartPage">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="80*"/>
            <RowDefinition Height="20*"/>
        </Grid.RowDefinitions>
        <StackPanel HorizontalAlignment="Center" Width="Auto">
            <TextBlock Text="Ваши товары"/>
            <ListBox x:Name="ProductsLB" ItemsSource="{Binding ProductsList}" SelectionChanged="ProductsLB_SelectionChanged" Grid.Row="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel>
                        <Image Source="{Binding Path}" Stretch="Uniform" Width="150" Height="100"/>
                        <TextBlock Text="{Binding ProductName, StringFormat=Название: {0}}"/>
                        <TextBlock Text="{Binding Price, StringFormat=Цена: {0}}"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        </StackPanel>

        <Button x:Name="BackBtn"  Content="Назад" Grid.Row="1" HorizontalAlignment="Left" Height="50" Width="100" Margin="10" Click="BackBtn_Click"/>
        <Button x:Name="NextBtn" Content="Далее" Height="50" Grid.Row="1" HorizontalAlignment="Right" Width="100" Margin="10" IsEnabled="False" Click="NextBtn_Click"/>
    </Grid>
</Page>
