<Page x:Class="AbsoluteCinema.Pages.LoginPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:AbsoluteCinema.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="LoginPage">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="10*"/>
            <RowDefinition Height="80*"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="1" HorizontalAlignment="Center" Width="250">
            <TextBlock Text="ВХОД" FontSize="36" HorizontalAlignment="Center" Margin="10"/>
            <TextBlock Text="Логин" FontSize="24" HorizontalAlignment="Left" Margin="10 0 0 0"/>
            <TextBox x:Name="FioTB" Width="220" Height="28" Margin="5"/>
            <TextBlock Text="Пароль" FontSize="24" HorizontalAlignment="Left" Margin="10 0 0 0"/>
            <TextBox x:Name="PasswordTB" Width="220" Height="28" Margin="10"/>
            <Button x:Name="LoginBtn" Click="LoginBtn_Click" Content="Войти" Height="35" Width="220"/>
            <TextBlock Text="Нет аккаунта?" FontSize="20" HorizontalAlignment="Center" Margin="0 10 0 5"/>
            <Button x:Name="RegBtn" Click="RegBtn_Click" Content="Зарегистрироваться" Height="35" Width="220"/>
        </StackPanel>
    </Grid>
</Page>
