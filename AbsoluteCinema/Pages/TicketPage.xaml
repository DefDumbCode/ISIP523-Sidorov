<Page x:Class="AbsoluteCinema.Pages.TicketPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:AbsoluteCinema.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="TicketPage">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="35*"/>
            <ColumnDefinition Width="65*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Orientation="Vertical" Grid.Column="0" VerticalAlignment="Center" >
            <Image x:Name="FilmImg" Source="{Binding Session.Films.ImagePath}" 
                   Width="200" Height="250"/>
            <TextBlock x:Name="FilmNameTB" Text="{Binding Session.Films.FilmName}" HorizontalAlignment="Center"
                       FontSize="18" TextWrapping="Wrap" Margin="20 10"/>
        </StackPanel>

        <StackPanel Orientation="Vertical" Grid.Column="1" VerticalAlignment="Center" Margin="20">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding Session.Rooms.Name, StringFormat=Зал: {0}}"   FontSize="24" Width="200"/>
                <TextBlock Text="{Binding Session.Rooms.RoomRate.RateName, StringFormat=Тип зала: {0}}" FontSize="24"/>
            </StackPanel>
            <TextBlock Text="{Binding Seats.PlaceName, StringFormat=Место: {0}}" FontSize="24"/>
            <TextBlock Text="{Binding Session.Date, StringFormat=Дата: {0}}" FontSize="24"/>
            <TextBlock x:Name="PriceTB" Text="Цена: " FontSize="24"/>
        </StackPanel>

        <Button x:Name="BackBtn" Grid.Column="0" Content="Назад" Click="BackBtn_Click"
                VerticalAlignment="Bottom" HorizontalAlignment="Left" Width="125" Height="55"  Margin="20 15"/>
        <Button x:Name="ConfirmBtn" Grid.Column="1" Content="Оформить" Click="ConfirmBtn_Click"
                VerticalAlignment="Bottom" HorizontalAlignment="Right" Width="125" Height="55" Margin="20 15"/>
    </Grid>
</Page>
