<Page x:Class="AbsoluteCinema.Pages.FilmPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:AbsoluteCinema.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="FilmPage">

    <Grid ScrollViewer.VerticalScrollBarVisibility="Visible">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="40*"/>
            <ColumnDefinition Width="60*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="20*"/>
            <RowDefinition Height="60*"/>
            <RowDefinition Height="20*"/>
        </Grid.RowDefinitions>
        <Button x:Name="BackBtn" Content="Назад" Click="BackBtn_Click" Grid.Column="0" Grid.Row="0"
                HorizontalAlignment="Left" Height="50" Width="125" Margin="20"/>
        <Image x:Name="FilmImg" Source="{Binding ImagePath}" Grid.Row="1" Width="200" Height="250"/>

        <StackPanel Orientation="Vertical" Margin="20 10" Grid.Column="1" Grid.Row="1" CanVerticallyScroll="True">
            <TextBlock x:Name="FilmName" FontSize="24"/>
            <TextBlock x:Name="FilmRate" FontSize="18"/>
            <TextBlock x:Name="FilmGenres" Text="" FontSize="18"/>
            <TextBlock x:Name="FilmDesc" TextWrapping="Wrap" FontSize="16"/>
        </StackPanel>

        <ListBox x:Name="SessionsLB" Grid.Row="2" Grid.ColumnSpan="2" SelectionChanged="SessionsLB_SelectionChanged" 
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Hidden" Margin="10">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel>
                        <TextBlock x:Name="RoomName" Text="{Binding Rooms.Name}"/>
                        <TextBlock x:Name="RoomRate" Text="{Binding Rooms.RoomRate.RateName}"/>
                        <TextBlock x:Name="SessionTime" Text="{Binding Date}"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel/>
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
        </ListBox>

    </Grid>
</Page>
