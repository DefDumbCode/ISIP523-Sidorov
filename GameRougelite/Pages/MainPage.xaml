<Page x:Class="GameRougelite.Pages.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:GameRougelite.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="MainPage">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="15*"/>
            <RowDefinition Height="5*"/>
            <RowDefinition Height="45*"/>
            <RowDefinition Height="5*"/>
            <RowDefinition Height="30*"/>
        </Grid.RowDefinitions>

        <Label x:Name="GameNameLbl" HorizontalAlignment="Center" VerticalAlignment="Center"
               Content="НАЗВАНИЕ ИГРЫ" FontSize="32" FontFamily="Trebuchet MS"/>
        
        <TextBlock x:Name="LevelTB" Grid.Row="1" HorizontalAlignment="Left"
                   Text="Этаж: " FontSize="18"/>
        <ProgressBar x:Name="EnemyHpBar" Grid.Row="1"
                     Width="300" Height="20"/>
        <TextBlock x:Name="EnemyHpTB" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center"
           Text="HP " FontSize="18"/>

        <Frame x:Name="GameFrame" Grid.Row="2" NavigationUIVisibility="Hidden"/>

        <ProgressBar x:Name="HpBar" Grid.Row="3"
                     Width="600"/>
        <TextBlock x:Name="HeroHpTB" Grid.Row="3" HorizontalAlignment="Center" VerticalAlignment="Center"
            Text="HP " FontSize="18"/>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="2*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Image x:Name="WeaponImg" Margin="5"/>
            <Button x:Name="AtkBtn" Grid.Row="1" 
                    Margin="5"
                    Click="AtkBtn_Click"/>

            <Image x:Name="ArmorImg" Grid.Column="1" Margin="5"/>
            <Button x:Name="BlockBtn" Grid.Row="1" Grid.Column="1" 
                Margin="5"
                Click="BlockBtn_Click"/>

            <TextBox x:Name="LogsTB" Grid.Column="2" Grid.Row="0" Grid.RowSpan="2"
                     Margin="5"
                     IsEnabled="False"/>

        </Grid>
    </Grid>
</Page>
