<Page x:Class="GameRougelike.Pages.GamePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:GameRougelike.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="720" d:DesignWidth="1280"
      Title="GamePage">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="10*"/>
            <RowDefinition Height="5*"/>
            <RowDefinition Height="50*"/>
            <RowDefinition Height="5*"/>
            <RowDefinition Height="30*"/>
        </Grid.RowDefinitions>

        <Label x:Name="GameNameLbl" HorizontalAlignment="Center" VerticalAlignment="Center"
               Content="НАЗВАНИЕ ИГРЫ" FontSize="32" FontFamily="Trebuchet MS"/>


        <TextBlock x:Name="LevelTB" Grid.Row="1" HorizontalAlignment="Center"
           Text="Этаж: " FontSize="20"/>

        <Grid x:Name="GameGrid" Grid.Row="2">
            <ListBox x:Name="EnemiesLB" d:ItemsSource="{d:SampleData ItemCount=3}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Vertical">
                            <TextBlock Text="{Binding EnemyName}" HorizontalAlignment="Center"
                                       FontSize="16"/>
                            <Image Source="{Binding enemyImg}"
                                   Width="300" Height="300"/>
                            <ProgressBar Value="{Binding HP}"
                                         Maximum="{Binding MaxHP}"
                                         Minimum="0"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel HorizontalAlignment="Center"/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
            </ListBox>

            <TextBlock x:Name="LootTB" VerticalAlignment="Bottom" HorizontalAlignment="Left"
                       FontSize="18"/>
            <TextBlock x:Name="HeroLootTB" VerticalAlignment="Bottom" HorizontalAlignment="Right"
                       FontSize="18" TextAlignment="Right"/>
            <Image x:Name="LootImg" HorizontalAlignment="Center"
                   Height="300" Width="300"/>

        </Grid>


        <ProgressBar x:Name="HpBar" Grid.Row="3"
                     Width="600"/>
        <TextBlock x:Name="HeroHpTB" Grid.Row="3" HorizontalAlignment="Center" VerticalAlignment="Center"
            Text="HP " FontSize="18"/>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="2*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Image x:Name="WeaponImg" Margin="5"/>
            <Button x:Name="AtkBtn" Grid.Row="1" 
                    Margin="5"
                    Click="AtkBtn_Click"/>

            <Image x:Name="ArmorImg" Grid.Column="1" Margin="5"/>
            <Button x:Name="BlockBtn" Grid.Row="1" Grid.Column="1" 
                Margin="5"
                Click="BlockBtn_Click"/>

            <TextBox x:Name="LogsTB" Grid.Column="2" Grid.Row="0" Grid.RowSpan="2"
                     Margin="5"
                     IsReadOnly="True"
                     ScrollViewer.CanContentScroll="True"
                     VerticalScrollBarVisibility="Visible"/>

        </Grid>
    </Grid>
</Page>
