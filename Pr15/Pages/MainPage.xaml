<Page x:Class="Pr15.Pages.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Pr15.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="MainPage">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="70*"/>
            <ColumnDefinition Width="30*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="10*"/>
            <RowDefinition Height="80*"/>
            <RowDefinition Height="10*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Конфигуратор ПК" FontSize="24" Margin="10 0"/>
        <ListBox x:Name="PartsLB" d:ItemsSource="{d:SampleData ItemCount=5}" Grid.Row="1" Margin="10">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal" Margin="5">
                        <Image Source="{Binding image}" Height="100" Width="100"/>
                        <TextBlock Text="{Binding preview}" Width="250" Margin="10 0 10 0" Padding="5" TextWrapping="Wrap"/>
                        <Button Width="100" Height="35" Content="Добавить" Click="Button_Click"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <TextBlock x:Name="PriceTB" Grid.Row="2" HorizontalAlignment="Left" Text="Цена: " Margin="20 0"/>
        <TextBlock x:Name="CompatibleTB" Grid.Row="2" HorizontalAlignment="Right" Margin="20 0"/>

        <Grid Grid.Row="1" Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="5*"/>
                <RowDefinition Height="2*"/>
            </Grid.RowDefinitions>
            <Label Content="Сборки" FontSize="20" Margin="10 0"/>
            <StackPanel Grid.Row="1" Orientation="Vertical" Margin="0 5">
                <TextBlock Text="Название" Margin="10 2"/>
                <TextBox x:Name="BuildTB" Width="200" Height="30" Margin="0 5"/>
                <TextBlock Text="Автор сборки" Margin="10 2"/>
                <TextBox x:Name="AuthorTB" Width="200" Height="30" Margin="0 5"/>
                <Button x:Name="SaveBtn"
                    Width="150" Height="50" Margin="0 10"
                    Content="Сохранить сборку" Click="SaveBtn_Click"/>
            </StackPanel>  
            <Button x:Name="ToBuildsBtn" Grid.Row="2"
                    Width="150" Height="50" Margin="0 10"
                    Content="К сборкам" Click="ToBuildsBtn_Click"/>
        </Grid>

    </Grid>
</Page>
