<Page x:Class="Pr15.Pages.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Pr15.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="MainPage">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="70*"/>
            <ColumnDefinition Width="30*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Margin="50 25">
            <TextBlock Text="Конфигуратор ПК" FontSize="24"/>
            <Grid Height="Auto" Margin="0 10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Text="Процессор" Grid.Row="0" Style="{StaticResource PartSelectTB}"/>
                <Button x:Name="CPUBtn" Grid.Row="0" Content="Добавить" Style="{StaticResource PartSelectBtn}"
                        Click="CPUBtn_Click"/>

                <TextBlock Text="Графический процессор" Grid.Row="1" Style="{StaticResource PartSelectTB}"/>
                <Button x:Name="GPUBtn" Grid.Row="1" Content="Добавить" Style="{StaticResource PartSelectBtn}"
                        Click="GPUBtn_Click"/>

                <TextBlock Text="ОЗУ" Grid.Row="2" Style="{StaticResource PartSelectTB}"/>
                <Button x:Name="RAMBtn" Grid.Row="2" Content="Добавить" Style="{StaticResource PartSelectBtn}"
                        Click="RAMBtn_Click"/>

                <TextBlock Text="Мат. плата" Grid.Row="3" Style="{StaticResource PartSelectTB}"/>
                <Button x:Name="MotherboardBtn" Grid.Row="3" Content="Добавить" Style="{StaticResource PartSelectBtn}"
                        Click="MotherboardBtn_Click"/>

                <TextBlock Text="Корпус" Grid.Row="4" Style="{StaticResource PartSelectTB}"/>
                <Button x:Name="CaseBtn" Grid.Row="4" Content="Добавить" Style="{StaticResource PartSelectBtn}"
                        Click="CaseBtn_Click"/>

                <TextBlock Text="Блок питания" Grid.Row="5" Style="{StaticResource PartSelectTB}"/>
                <Button x:Name="PowerSupplyBtn" Grid.Row="5" Content="Добавить" Style="{StaticResource PartSelectBtn}"
                        Click="PowerSupplyBtn_Click"/>

                <TextBlock Text="Кулер" Grid.Row="6" Style="{StaticResource PartSelectTB}"/>
                <Button x:Name="CoolerBtn" Grid.Row="6" Content="Добавить" Style="{StaticResource PartSelectBtn}"
                        Click="CoolerBtn_Click"/>

                <TextBlock Text="Накопитель" Grid.Row="7" Style="{StaticResource PartSelectTB}"/>
                <Button x:Name="StorageBtn" Grid.Row="7" Content="Добавить" Style="{StaticResource PartSelectBtn}"
                        Click="StorageBtn_Click"/>
            </Grid>
        </StackPanel>
        
        <Grid Margin="20 25" Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="20"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Text="Сохраненные сборки"/>
            <ListBox x:Name="BuidsLB" Grid.Row="1">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBox Text="{Binding BuidName}"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

        </Grid>
        
    </Grid>
</Page>
