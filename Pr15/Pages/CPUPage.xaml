<Page x:Class="Pr15.Pages.CPUPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Pr15.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="CPUPage">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="20*"/>
            <ColumnDefinition Width="75*"/>
        </Grid.ColumnDefinitions>
        <ListBox x:Name="CPULB" d:ItemsSource="{d:SampleData ItemCount=5}" Margin="10" Grid.Column="1">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="3*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Image Source="{Binding image}"   
                               Grid.Column="0" Width="150" Height="150" Margin="5 0"/>
                        <TextBlock Width="250" TextWrapping="Wrap" Grid.Column="1" Margin="5 10">
                            <TextBlock.Text>
                                <MultiBinding StringFormat=" {0}">
                                    <Binding Path="preview"/>
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                        <Button x:Name="AddBtn" Grid.Column="2" Width="120" Height="75" Content="Добавить" Click="AddBtn_Click" Margin="5"/>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Button x:Name="BackBtn" VerticalAlignment="Top" Click="BackBtn_Click" Content="Назад"
                Width="120" Height="75" Margin="0 20"/>
    </Grid>
</Page>
