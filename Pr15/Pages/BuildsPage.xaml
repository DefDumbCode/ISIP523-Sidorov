<Page x:Class="Pr15.Pages.BuildsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Pr15.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="BuildsPage">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="4*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0">
            <Label Content="Сохраненные сборки" FontSize="24" Margin="20 0"/>
            <ListBox x:Name="AssemblesLB" ScrollViewer.HorizontalScrollBarVisibility="Disabled" 
                     d:ItemsSource="{d:SampleData ItemCount=5}"
                     Height="350" Margin="15"
                     SelectionChanged="AssemblesLB_SelectionChanged">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Width="550">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="4*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel HorizontalAlignment="Left" Orientation="Vertical" Width="400">
                            <TextBlock Text="{Binding name}"/>
                            <TextBlock Text="{Binding author}"/>
                            <TextBlock Text="{Binding CalculatePrice}"/>
                            <ListBox ItemsSource="{Binding partassembly_}" x:Name="PartsLB" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <TextBlock Text="{Binding basepart_.name}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            </StackPanel>
                            <Button x:Name="EditBtn" Grid.Column="1"
                                    Content="Редактировать"
                                    Height="50"
                                    Click="EditBtn_Click"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </StackPanel>
        <StackPanel Grid.Column="1" VerticalAlignment="Bottom">
            <Button x:Name="DelBTN" Content="Удалить" FontSize="16" 
                    Width="100" Height="60" Margin="15" 
                    Click="DelBTN_Click" IsEnabled="False"/>
            <Button x:Name="BackBTN" Content="Назад" FontSize="16"  
                    Width="100" Height="60" Margin="15" 
                    Click="BackBTN_Click"/>
        </StackPanel>
    </Grid>
</Page>
